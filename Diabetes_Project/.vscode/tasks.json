{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Train Model",
      "type": "shell",
      "command": "python main.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Backend API",
      "type": "shell",
      "command": "uvicorn api:app --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Streamlit UI",
      "type": "shell",
      "command": "streamlit run app.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
